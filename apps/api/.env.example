# npm run db:up自动生成本机只读应用连接，密码不提交。
# 手工配置时使用postgresql+psycopg协议；空值表示尚未配置。
DATABASE_URL=
APP_ENV=development
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT_SECONDS=5

# 内容复用仅在随机本机PG测试库试验；生产/普通项目库不可启用。
CONTENT_REUSE_ENABLED=false

# 本机问答默认 DeepSeek。业务数据开关与授权范围须另行启用。
ASSISTANT_MODEL=deepseek:deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 仅作用于实际发给 DeepSeek 官方的问答，固定 SOP 预测由服务端计算。
DEEPSEEK_THINKING_ENABLED=true

# 公共 SOP 原文及预测任务共用。服务 PATH 缺少 CLI 或 Node 时填本机原生可执行文件的绝对路径。
LARK_CLI_BIN=lark-cli

# 仅在获准向获准的 DeepSeek 官方发送必要查询摘要后启用。
ASSISTANT_BUSINESS_DATA_ENABLED=false
ASSISTANT_BUSINESS_PROVIDERS=["deepseek"]
