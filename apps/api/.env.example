# npm run db:up自动生成本机只读应用连接，密码不提交。
# 手工配置时使用postgresql+psycopg协议；空值表示尚未配置。
DATABASE_URL=
APP_ENV=development
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT_SECONDS=5

# 内容复用仅在随机本机PG测试库试验；生产/普通项目库不可启用。
CONTENT_REUSE_ENABLED=false

# 本地问答试用。留空关闭；Codex 使用当前开发者的 CLI 登录。
# ASSISTANT_MODEL=openai-codex:gpt-6.2-sol
# 换 DeepSeek 时使用 deepseek:<账号可用型号> 并设置 DEEPSEEK_API_KEY。
ASSISTANT_MODEL=
# 可选型号按列表顺序显示，默认型号自动排在首位。
# ASSISTANT_MODEL_CHOICES=["openai-codex:gpt-6.2-astra"]
DEEPSEEK_API_KEY=
# 百炼使用 bailian:qwen3.8-flash；地址可采用控制台导出的兼容入口。
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 仅在已授权向相应模型发送选定商品的必要汇总时，在本机启用。
ASSISTANT_BUSINESS_DATA_ENABLED=false
ASSISTANT_BUSINESS_PROVIDERS=["openai-codex"]
