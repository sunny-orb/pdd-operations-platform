# 复制为服务器部署目录.env.runtime，chmod 600；raw格式不加引号。
# URL内口令须百分号编码；不填写或提交真实凭据。
DATABASE_URL=postgresql+psycopg://songbing:REPLACE_URL_ENCODED_PASSWORD@pg.kktree.cn:5432/pdd_dashboard?sslmode=require
SYNC_DATABASE_URL=postgresql+psycopg://songbing:REPLACE_URL_ENCODED_PASSWORD@pg.kktree.cn:5432/pdd_dashboard?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT_SECONDS=5
CORS_ORIGINS=["https://pdd-operations.kktree.cn"]
# 启用同步时另行填入已授权的来源口令；API不需要该值。
# WAREHOUSE_PASSWORD=

# AI按当前匿名站点访问策略开放。密钥只放服务器600权限文件。
ASSISTANT_PRODUCTION_ENABLED=false
ASSISTANT_BUSINESS_DATA_ENABLED=false
ASSISTANT_BUSINESS_PROVIDERS=["deepseek"]
ASSISTANT_MODEL=deepseek:deepseek-flash
ASSISTANT_MAX_CONCURRENT=2
ASSISTANT_REQUESTS_PER_MINUTE=20
DEEPSEEK_API_KEY=REPLACE_APPROVED_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
