FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api
WORKDIR /app
COPY apps/api/requirements-dev.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock && useradd --uid 10001 --create-home app
COPY apps/api/app apps/api/app
COPY apps/api/migrations_v2 apps/api/migrations_v2
COPY apps/api/alembic-v2.ini apps/api/alembic-v2.ini
COPY scripts/render-db-schema.py scripts/init-deployment-db.py scripts/sync-project.py scripts/archive-maintenance.py scripts/
COPY config config
RUN mkdir -p /app/var && chown app:app /app/var
USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
